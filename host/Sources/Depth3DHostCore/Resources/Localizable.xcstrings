    "media.cloud.guide.desc": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 还没有配置网盘挂载工具。只需简单两步，即可把 Google Drive 等网盘里的影片直接同步给头显播放。"
          }
        }
      }
    },
    "media.cloud.guide.steps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在“终端”安装工具：brew install rclone\n2. 运行 rclone config 绑定你的网盘账号，完成后点击右上角“重新检测”。"
          }
        }
      }
    },
    "media.cloud.guide.title": {
