{
  "api": 1,
  "id": "dev.depth3d.jellyfin",
  "name": "$t:plugin_name",
  "version": "1.0.0",
  "author": "depth3d",
  "description": "$t:plugin_desc",
  "homepage": "https://depth3d.dev/plugins/jellyfin",
  "license": "GPL-3.0-or-later",
  "minApp": "1.0.0",
  "multiInstance": true,
  "capabilities": [
    "search",
    "progress",
    "favorites",
    "played",
    "filters",
    "subtitles",
    "categories"
  ],
  "permissions": {
    "hosts": [],
    "userHosts": true,
    "lan": true
  },
  "config": [
    {
      "key": "server",
      "type": "url",
      "label": "$t:cfg_server",
      "required": true,
      "discover": "_jellyfin._tcp",
      "placeholder": "http://192.168.1.10:8096"
    },
    {
      "key": "username",
      "type": "text",
      "label": "$t:cfg_username",
      "required": true
    },
    {
      "key": "password",
      "type": "password",
      "label": "$t:cfg_password"
    },
    {
      "key": "quality",
      "type": "select",
      "label": "$t:cfg_quality",
      "options": [
        { "value": "direct", "label": "$t:q_direct" },
        { "value": "1080p", "label": "$t:q_1080p" },
        { "value": "720p", "label": "$t:q_720p" },
        { "value": "480p", "label": "$t:q_480p" }
      ],
      "default": "direct"
    }
  ],
  "auth": "form"
}
